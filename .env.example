# KMCult'26 — Oracle Cloud Object Storage & Application Deployment Configuration
# Copy this file to .env or configure in Secret Manager / Deployment Environment Secrets

# -------------------------------------------------------------
# 1. Oracle Cloud Infrastructure (OCI) Object Storage Settings
# -------------------------------------------------------------
OCI_REGION=ap-hyderabad-1
OCI_NAMESPACE=axlcprs8kzil
OCI_BUCKET=kmcult26-photos
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaazt3ayifh4oeebxzwugqixhl4szosgf5massplzbesikpduybjlga
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaqznnkb5k5nvenohuft73744ooteeurl2c2fi245eeukecz3xfida
OCI_FINGERPRINT=0a:ca:c6:db:90:2d:3d:27:a3:0a:88:e6:d0:b6:f7:a1

# -------------------------------------------------------------
# 2. OCI API Signing Key (RSA Private Key PEM)
# Required for server-side REST API signing. Store in Secret Manager.
# Format: Single line string with escaped newlines (\n) or standard multiline PEM
# -------------------------------------------------------------
OCI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# -------------------------------------------------------------
# 3. Storage Allowance & Limits (in Bytes)
# Default: 10 GB (10,737,418,240 bytes)
# -------------------------------------------------------------
OCI_STORAGE_ALLOWANCE_BYTES=10737418240

# -------------------------------------------------------------
# 4. Server Environment Settings
# -------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Secret for signing stateless edit session tokens (JWT)
# Use a long, unique random string for production.
SESSION_SECRET=kmc26_default_secret_change_me_in_prod
